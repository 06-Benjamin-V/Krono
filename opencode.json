{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git commit": "deny",
      "git commit *": "deny",
      "git push": "deny",
      "git push *": "deny",
      "git reset --hard": "deny",
      "git reset --hard *": "deny",
      "git clean": "deny",
      "git clean *": "deny"
    }
  }
}
