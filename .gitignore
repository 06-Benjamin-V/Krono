# IMPORTANTE:
# NO ignorar android/ completo.
# El proyecto Android debe mantenerse en Git.

# Builds generados por Gradle
android/app/build/
android/build/
android/.gradle/
android/**/build/

# Configuración local de cada PC
android/local.properties

# Archivo generado por Capacitor
android/capacitor.config.json

# Archivos web copiados automáticamente por Capacitor
android/app/src/main/assets/public/

# Plugins generados automáticamente
android/capacitor-cordova-android-plugins/

# Archivos temporales de compilación nativa
android/.externalNativeBuild/
android/.cxx/
android/captures/


