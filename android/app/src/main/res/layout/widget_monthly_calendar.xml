<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF6F5"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Month header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_prev_month"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="‹"
            android:textColor="#722F37"
            android:textSize="28sp"
            android:textStyle="bold"
            android:contentDescription="Mes anterior" />

        <TextView
            android:id="@+id/tv_month_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="septiembre 2026"
            android:textColor="#1A1A1A"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_next_month"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:gravity="center"
            android:text="›"
            android:textColor="#722F37"
            android:textSize="28sp"
            android:textStyle="bold"
            android:contentDescription="Mes siguiente" />
    </LinearLayout>

    <!-- Weekday labels -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <TextView android:id="@+id/tv_wd_0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="L" android:textColor="#6E5D60" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:id="@+id/tv_wd_1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="M" android:textColor="#6E5D60" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:id="@+id/tv_wd_2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="X" android:textColor="#6E5D60" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:id="@+id/tv_wd_3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="J" android:textColor="#6E5D60" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:id="@+id/tv_wd_4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="V" android:textColor="#6E5D60" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:id="@+id/tv_wd_5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="S" android:textColor="#6E5D60" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:id="@+id/tv_wd_6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="D" android:textColor="#6E5D60" android:textSize="11sp" android:textStyle="bold" />
    </LinearLayout>

    <!-- Divider (LinearLayout: plain View is not supported by RemoteViews) -->
    <LinearLayout
        android:id="@+id/divider_monthly"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="2dp"
        android:background="#E7DCDD" />

    <!-- 6 week rows, each populated dynamically via addView with widget_calendar_day_cell -->
    <LinearLayout
        android:id="@+id/week_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />

    <LinearLayout
        android:id="@+id/week_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />

    <LinearLayout
        android:id="@+id/week_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />

    <LinearLayout
        android:id="@+id/week_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />

    <LinearLayout
        android:id="@+id/week_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />

    <LinearLayout
        android:id="@+id/week_5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />

    <!-- Counters -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_task_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tareas: 0"
            android:textColor="#1A1A1A"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_counter_sep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:text="·"
            android:textColor="#7A6A6D"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_event_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Eventos: 0"
            android:textColor="#1A1A1A"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
